# Configuration de production (docker-compose.prod.yml). Copier en .env.production — jamais commité.

# Base de données
POSTGRES_PASSWORD=change-moi-par-un-mot-de-passe-long

# Secret des sessions : 32+ caractères aléatoires (l'exemple de développement est refusé)
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Adresse publique du site (liens des e-mails, CORS)
APP_URL=https://aether.exemple.fr
WEB_ORIGIN=https://aether.exemple.fr
WEB_PORT=8080

# E-mails réels
MAIL_TRANSPORT=smtp
SMTP_URL=smtps://utilisateur:motdepasse@smtp.exemple.fr:465
MAIL_FROM=AETHER <no-reply@aether.exemple.fr>

# Compte administrateur créé au premier déploiement (12 caractères minimum)
ADMIN_EMAIL=
ADMIN_PASSWORD=

LOG_LEVEL=info
DAILY_TIMEZONE=Europe/Paris
GUEST_RETENTION_DAYS=30
