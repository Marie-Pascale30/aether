{
  "name": "aether",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "npm run prisma:migrate -w @aether/api",
    "db:seed": "npm run prisma:seed -w @aether/api",
    "setup": "npm run db:up && npm run build -w @aether/shared && npm run db:migrate && npm run db:seed",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @aether/shared && npm run build -w @aether/api && npm run build -w @aether/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "typescript": "~5.9.3"
  }
}
