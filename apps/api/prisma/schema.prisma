generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  /// `null` tant que le joueur est invité.
  email        String?  @unique
  passwordHash String?
  displayName  String
  role         Role     @default(PLAYER)
  isGuest      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  progress LevelProgress[]
  sessions PlaySession[]
  daily    DailyResult[]
}

/// Genre d'énigme : paires, groupes (3–4 cases) ou suites ordonnées (3–5 cases).
enum LevelKind {
  PAIRS
  GROUPS
  SEQUENCE
}

/// Un monde regroupe des énigmes et possède son propre jardin.
/// Il s'ouvre quand le monde précédent est entièrement restauré.
model World {
  id          String   @id @default(cuid())
  /// Identifiant d'URL (`/mondes/<slug>`).
  slug        String   @unique
  order       Int
  title       String
  tagline     String
  description String
  /// Palette du jardin : origines | foret | ocean | cosmos.
  theme       String   @default("origines")
  published   Boolean  @default(true)
  /// Réserve de l'énigme du jour : hors du parcours, du classement et de la progression.
  isDaily     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  levels Level[]

  @@index([published, order])
}

model Level {
  id          String    @id @default(cuid())
  worldId     String
  /// Position dans le monde (tri croissant). Les trous sont permis.
  order       Int
  title       String
  description String
  /// Révélés un par un, à la demande du joueur.
  hints       String[]
  symbols     String[]
  columns     Int       @default(4)
  kind        LevelKind @default(PAIRS)
  /// Réponses : tableau de groupes d'indices `[[a, b, …], …]` (ordonnés pour une suite).
  /// Jamais envoyé au joueur.
  groups      Json
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  world    World           @relation(fields: [worldId], references: [id], onDelete: Cascade)
  progress LevelProgress[]
  sessions PlaySession[]
  attempts Attempt[]
  daily    DailyChallenge[]

  @@index([worldId, published, order])
}

/// Meilleur résultat d'un joueur sur une énigme.
model LevelProgress {
  userId           String
  levelId          String
  bestStars        Int
  bestTimeMs       Int
  completions      Int      @default(1)
  firstCompletedAt DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  level Level @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@id([userId, levelId])
  @@index([levelId])
}

/// Une tentative de résolution d'une énigme, validée coup par coup par le serveur.
model PlaySession {
  id          String    @id @default(cuid())
  userId      String
  levelId     String
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  /// Indices (dans `Level.groups`) des groupes déjà trouvés.
  foundGroups Int[]
  mistakes    Int       @default(0)
  hintsUsed   Int       @default(0)
  stars       Int?
  durationMs  Int?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  level    Level     @relation(fields: [levelId], references: [id], onDelete: Cascade)
  attempts Attempt[]

  @@index([userId, levelId, completedAt])
}

/// Chaque coup joué, juste ou faux : sert aux statistiques de conception des énigmes
/// (taux de réussite, fausses pistes les plus fréquentes).
model Attempt {
  id        String   @id @default(cuid())
  sessionId String
  /// Copié depuis la partie pour agréger par énigme sans jointure.
  levelId   String
  /// Cases choisies, dans l'ordre de sélection.
  cells     Int[]
  correct   Boolean
  createdAt DateTime @default(now())

  session PlaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  level   Level       @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@index([levelId, correct])
}

/// Énigme tirée pour un jour donné (fuseau DAILY_TIMEZONE), identique pour tous les joueurs.
model DailyChallenge {
  date      DateTime @id @db.Date
  levelId   String
  createdAt DateTime @default(now())

  level   Level         @relation(fields: [levelId], references: [id], onDelete: Cascade)
  results DailyResult[]

  @@index([levelId, date])
}

/// Première victoire d'un joueur sur l'énigme du jour : la seule qui compte pour la série.
model DailyResult {
  userId     String
  date       DateTime @db.Date
  sessionId  String
  stars      Int
  durationMs Int
  mistakes   Int
  hintsUsed  Int
  /// Coups joués dans l'ordre (true = juste), pour le résumé à partager.
  pattern    Boolean[]
  createdAt  DateTime @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge DailyChallenge @relation(fields: [date], references: [date], onDelete: Cascade)

  @@id([userId, date])
  @@index([date])
}
