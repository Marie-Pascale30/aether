generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  /// `null` tant que le joueur est invité.
  email        String?  @unique
  passwordHash String?
  displayName  String
  role         Role     @default(PLAYER)
  isGuest      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  progress LevelProgress[]
  sessions PlaySession[]
}

/// Genre d'énigme : paires, groupes (3–4 cases) ou suites ordonnées (3–5 cases).
enum LevelKind {
  PAIRS
  GROUPS
  SEQUENCE
}

/// Un monde regroupe des énigmes et possède son propre jardin.
/// Il s'ouvre quand le monde précédent est entièrement restauré.
model World {
  id          String   @id @default(cuid())
  /// Identifiant d'URL (`/mondes/<slug>`).
  slug        String   @unique
  order       Int
  title       String
  tagline     String
  description String
  /// Palette du jardin : origines | foret | ocean | cosmos.
  theme       String   @default("origines")
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  levels Level[]

  @@index([published, order])
}

model Level {
  id          String    @id @default(cuid())
  worldId     String
  /// Position dans le monde (tri croissant). Les trous sont permis.
  order       Int
  title       String
  description String
  /// Révélés un par un, à la demande du joueur.
  hints       String[]
  symbols     String[]
  columns     Int       @default(4)
  kind        LevelKind @default(PAIRS)
  /// Réponses : tableau de groupes d'indices `[[a, b, …], …]` (ordonnés pour une suite).
  /// Jamais envoyé au joueur.
  groups      Json
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  world    World           @relation(fields: [worldId], references: [id], onDelete: Cascade)
  progress LevelProgress[]
  sessions PlaySession[]

  @@index([worldId, published, order])
}

/// Meilleur résultat d'un joueur sur une énigme.
model LevelProgress {
  userId           String
  levelId          String
  bestStars        Int
  bestTimeMs       Int
  completions      Int      @default(1)
  firstCompletedAt DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  level Level @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@id([userId, levelId])
  @@index([levelId])
}

/// Une tentative de résolution d'une énigme, validée coup par coup par le serveur.
model PlaySession {
  id          String    @id @default(cuid())
  userId      String
  levelId     String
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  /// Indices (dans `Level.groups`) des groupes déjà trouvés.
  foundGroups Int[]
  mistakes    Int       @default(0)
  hintsUsed   Int       @default(0)
  stars       Int?
  durationMs  Int?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  level Level @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@index([userId, levelId, completedAt])
}
