# Base PostgreSQL lancée par `npm run db:up` (docker-compose.yml, port 5433)
DATABASE_URL="postgresql://aether:aether@localhost:5433/aether?schema=public"

# Secret de signature des sessions : au moins 32 caractères aléatoires en production
JWT_SECRET="remplace-moi-par-une-longue-chaine-aleatoire-de-32-caracteres-minimum"

PORT=4100
# Origine du front, autorisée par CORS (le front passe normalement par son proxy /api)
WEB_ORIGIN="http://localhost:3100"

# Compte administrateur créé par `npm run db:seed` (accès à l'éditeur de niveaux)
ADMIN_EMAIL="admin@aether.local"
ADMIN_PASSWORD="change-moi-vite"
