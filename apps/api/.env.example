# Base PostgreSQL lancée par `npm run db:up` (docker-compose.yml, port 5433)
DATABASE_URL="postgresql://aether:aether@localhost:5433/aether?schema=public"

# Secret de signature des sessions : au moins 32 caractères aléatoires.
# La valeur ci-dessous est refusée quand NODE_ENV=production.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="remplace-moi-par-une-longue-chaine-aleatoire-de-32-caracteres-minimum"

PORT=4100
# Origine du front, autorisée par CORS (le front passe normalement par son proxy /api)
WEB_ORIGIN="http://localhost:3100"
# Adresse publique du site, utilisée dans les liens des e-mails
APP_URL="http://localhost:3100"
# fatal | error | warn | info | debug | trace
LOG_LEVEL="info"

# E-mails (vérification d'adresse, mot de passe oublié)
#   log  : écrits dans apps/api/.mail-outbox/ (développement, rien n'est envoyé)
#   smtp : envoi réel via SMTP_URL, ex. smtps://utilisateur:motdepasse@smtp.exemple.com:465
MAIL_TRANSPORT="log"
SMTP_URL=""
MAIL_FROM="AETHER <no-reply@aether.local>"

# Nettoyage automatique (chaque nuit)
GUEST_RETENTION_DAYS=30
OPEN_SESSION_RETENTION_DAYS=7

# Compte administrateur créé par `npm run db:seed` (accès à l'éditeur de niveaux).
# En production : 12 caractères minimum, et la valeur d'exemple est refusée.
ADMIN_EMAIL="admin@aether.local"
ADMIN_PASSWORD="change-moi-vite"
