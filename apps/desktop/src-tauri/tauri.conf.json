{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AETHER",
  "version": "0.1.0",
  "identifier": "fr.aether.atlas",
  "build": {
    "frontendDist": "../../web/out",
    "devUrl": "http://localhost:3100"
  },
  "app": {
    "windows": [
      {
        "title": "AETHER",
        "width": 1200,
        "height": 860,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0b1626"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "media-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://aether-api-n5qk.onrender.com https://aether-five-lovat.vercel.app",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "frame-src": "'none'"
      },
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Offrez à votre esprit un moment de plaisir.",
    "longDescription": "AETHER : des énigmes paisibles qui restaurent l'Atlas des Esprits.",
    "category": "PuzzleGame",
    "copyright": "AETHER"
  }
}