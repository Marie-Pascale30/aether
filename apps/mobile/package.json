{
  "name": "@aether/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Applications Android et iOS d'AETHER (Capacitor), autour de l'export statique du site.",
  "scripts": {
    "build": "npm run build:app -w @aether/web && cap sync",
    "sync": "cap sync",
    "assets": "capacitor-assets generate --android --ios --iconBackgroundColor \"#0b1626\" --iconBackgroundColorDark \"#0b1626\" --splashBackgroundColor \"#0b1626\" --splashBackgroundColorDark \"#0b1626\"",
    "android": "cap open android",
    "ios": "cap open ios"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  }
}
